# How the form delivers a lead: "mailto" (opens the visitor's email app) or "webhook" (POST to n8n).
# Leave empty to choose automatically: webhook if PUBLIC_N8N_WEBHOOK_URL exists, otherwise mailto.
PUBLIC_LEAD_DELIVERY=

# Public n8n webhook URL that receives leads (used when delivery is "webhook").
PUBLIC_N8N_WEBHOOK_URL=

# GTM container ID (GTM-XXXXXXX). Without it, analytics runs in Noop mode.
PUBLIC_GTM_ID=

# Enables/disables the form. The WhatsApp fallback remains available.
PUBLIC_FORM_ENABLED=true

# Version of the LGPD consent text accepted by the form.
PUBLIC_CONSENT_VERSION=2026-10.1

# Timeout for the POST to n8n, in milliseconds.
PUBLIC_N8N_TIMEOUT_MS=12000

# Google Places API (New) key, used ONLY at build time to fetch reviews.
# Never use the PUBLIC_ prefix: the key must not reach the browser.
GOOGLE_PLACES_API_KEY=

# Optional: overrides the Place ID configured in src/shared/config/site.ts.
GOOGLE_PLACE_ID=
