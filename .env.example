# Como o formulário entrega o lead: "mailto" (abre o e-mail do cliente) ou "webhook" (POST para o n8n).
# Deixe vazio para decidir automaticamente: webhook se PUBLIC_N8N_WEBHOOK_URL existir, senão mailto.
PUBLIC_LEAD_DELIVERY=

# URL pública do webhook n8n que recebe os leads (usada quando a entrega é "webhook").
PUBLIC_N8N_WEBHOOK_URL=

# ID do contêiner GTM (GTM-XXXXXXX). Sem ele, o analytics fica em modo Noop.
PUBLIC_GTM_ID=

# Liga/desliga o formulário. O fallback de WhatsApp continua disponível.
PUBLIC_FORM_ENABLED=true

# Versão do texto de consentimento LGPD aceito no formulário.
PUBLIC_CONSENT_VERSION=2026-10.1

# Timeout do POST para o n8n, em milissegundos.
PUBLIC_N8N_TIMEOUT_MS=12000

# Chave da Places API (New) do Google, usada SOMENTE no build para buscar as avaliações.
# Nunca use o prefixo PUBLIC_: a chave não pode chegar ao navegador.
GOOGLE_PLACES_API_KEY=

# Opcional: sobrescreve o Place ID configurado em src/shared/config/site.ts.
GOOGLE_PLACE_ID=
