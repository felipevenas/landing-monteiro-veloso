---
interface Props {
  tone?: 'light' | 'dark';
  class?: string;
}

const { tone = 'light', class: className } = Astro.props;
---

<p
  class:list={[
    'flex items-center gap-3 text-[0.68rem] font-bold uppercase tracking-[0.2em]',
    tone === 'dark' ? 'text-sky-300' : 'text-blue-600',
    className,
  ]}
>
  <span class:list={['h-px w-8', tone === 'dark' ? 'bg-sky-300/70' : 'bg-blue-500/70']}></span>
  <slot />
</p>
