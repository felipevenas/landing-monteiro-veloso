---
import Container from '@/shared/ui/Container.astro';
import Icon from '@/shared/ui/Icon.astro';
import Logo from '@/shared/ui/Logo.astro';
import LogoMark from '@/shared/ui/LogoMark.astro';
import { publishable } from '@/shared/config/field';
import { routes } from '@/shared/config/routes';
import { fullAddress, googleReviewsUrl, mapQuery, site } from '@/shared/config/site';

const oab = publishable(site.lawyer.oab);
const hours = publishable(site.hours);
const year = new Date().getFullYear();
const mapsUrl = `https://www.google.com/maps/search/?api=1&query=${mapQuery()}`;
const reviewsUrl = googleReviewsUrl();
const credit = `Responsável: ${site.lawyer.name}, ${site.lawyer.role}${oab ? ` / OAB/BA ${oab}` : ''}. Conteúdo informativo, sem promessa de resultado.`;
const label = 'text-[0.6rem] font-bold uppercase tracking-[0.2em] text-sky-300';

const navigation = [
  { label: 'Início', href: routes.home },
  { label: 'Serviços', href: '/#areas' },
  { label: 'Avaliações', href: '/#avaliacoes' },
  { label: 'Instagram', href: '/#instagram' },
  { label: 'Localização', href: '/#localizacao' },
  { label: 'Contato', href: '/#contato' },
];
---

<footer class="relative overflow-hidden bg-ink text-blue-200/80">
  <div
    class="h-px bg-gradient-to-r from-transparent via-white/25 to-transparent"
    aria-hidden="true"
  ></div>

  <div
    class="pointer-events-none absolute -right-24 -bottom-36 hidden opacity-[0.05] md:block"
    aria-hidden="true"
  >
    <LogoMark height={480} loading="lazy" />
  </div>

  <Container class="relative">
    <div class="grid gap-12 pt-14 pb-12 sm:pt-16 sm:pb-14 md:grid-cols-2 lg:grid-cols-[1.1fr_0.6fr_0.8fr]">
      <div>
        <a href={routes.home} class="inline-block" aria-label={`${site.name}: página inicial`}>
          <Logo height={62} class="h-[62px] w-auto" loading="lazy" />
        </a>
        <p class="mt-6 max-w-sm text-sm leading-relaxed text-blue-200/70">
          Defesa de pessoas físicas contra bancos e financeiras: busca e apreensão, revisional de
          financiamento e cobrança. Salvador e todo o Brasil.
        </p>
        <div class="mt-7 flex flex-col items-start gap-2.5">
          <a
            class="group inline-flex items-center gap-2 text-[0.7rem] font-bold uppercase tracking-[0.16em] text-blue-200/80 transition hover:text-white"
            href={site.social.instagram}
            target="_blank"
            rel="noopener noreferrer"
          >
            Instagram do escritório
            <Icon
              name="lucide:arrow-up-right"
              size={13}
              class="transition duration-200 group-hover:-translate-y-0.5 group-hover:translate-x-0.5"
            />
          </a>
          <a
            class="group inline-flex items-center gap-2 text-[0.7rem] font-bold uppercase tracking-[0.16em] text-blue-200/80 transition hover:text-white"
            href={site.social.instagramLawyer}
            target="_blank"
            rel="noopener noreferrer"
          >
            Instagram da Dra. Roberta
            <Icon
              name="lucide:arrow-up-right"
              size={13}
              class="transition duration-200 group-hover:-translate-y-0.5 group-hover:translate-x-0.5"
            />
          </a>
          <a
            class="group inline-flex items-center gap-2 text-[0.7rem] font-bold uppercase tracking-[0.16em] text-blue-200/80 transition hover:text-white"
            href={site.phone.whatsapp}
            data-wa
            data-wa-location="footer"
            target="_blank"
            rel="noopener noreferrer"
          >
            WhatsApp
            <Icon
              name="lucide:arrow-up-right"
              size={13}
              class="transition duration-200 group-hover:-translate-y-0.5 group-hover:translate-x-0.5"
            />
          </a>
        </div>
      </div>

      <nav aria-label="Navegação do rodapé">
        <h2 class={label}>Navegação</h2>
        <ul class="mt-5 space-y-3 text-sm">
          {navigation.map((item) => (
            <li>
              <a
                class="inline-block py-0.5 text-blue-200/75 transition hover:text-white"
                href={item.href}
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
        <a
          href={routes.landing}
          class="mt-6 flex items-center justify-between gap-3 border-t border-white/10 pt-4 text-sm font-semibold text-white transition hover:text-sky-300"
        >
          Busca e apreensão de veículo
          <Icon name="lucide:arrow-up-right" size={14} class="shrink-0" />
        </a>
      </nav>

      <div>
        <h2 class={label}>Escritório</h2>
        <address class="mt-5 not-italic text-sm leading-relaxed text-blue-200/70">
          {fullAddress()}
        </address>

        <a
          class="mt-5 block font-display text-[1.3rem] leading-tight text-white transition hover:text-sky-300"
          href={`tel:${site.phone.e164}`}
        >
          {site.phone.display}
        </a>
        <a
          class="mt-1 block break-all text-sm text-blue-200/70 transition hover:text-white"
          href={`mailto:${site.email}`}
        >
          {site.email}
        </a>

        <div class="mt-6">
          <p class={label}>Horário</p>
          <p class="mt-1.5 text-sm leading-relaxed text-blue-200/70">
            {hours ?? 'Consulte a equipe pelo WhatsApp.'}
          </p>
        </div>

        <div class="mt-5 flex flex-wrap gap-x-5 gap-y-2 text-[0.76rem] font-semibold">
          <a
            class="inline-flex items-center gap-1.5 text-blue-200/70 transition hover:text-white"
            href={mapsUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            Google Maps
            <Icon name="lucide:arrow-up-right" size={12} />
          </a>
          {reviewsUrl && (
            <a
              class="inline-flex items-center gap-1.5 text-blue-200/70 transition hover:text-white"
              href={reviewsUrl}
              target="_blank"
              rel="noopener noreferrer"
            >
              Avaliações no Google
              <Icon name="lucide:arrow-up-right" size={12} />
            </a>
          )}
        </div>
      </div>
    </div>

    <div class="border-t border-white/10 py-8">
      <div class="grid gap-6 lg:grid-cols-[1.5fr_0.5fr]">
        <div class="max-w-4xl space-y-2.5 text-[0.72rem] leading-relaxed text-blue-200/60">
          <p>
            As informações deste site têm caráter informativo e não constituem promessa de resultado
            nem substituem a análise individualizada de cada caso. Cada situação depende do
            contrato, do processo e das circunstâncias concretas.
          </p>
          <p>{credit}</p>
        </div>
        <div class="flex flex-col gap-2 text-[0.72rem] text-blue-200/60 lg:items-end lg:text-right">
          <a class="transition hover:text-white" href={routes.privacy}>
            Política de privacidade
          </a>
          <button
            type="button"
            class="text-left transition hover:text-white lg:text-right"
            data-consent-open
          >
            Preferências de cookies
          </button>
        </div>
      </div>

      <div class="mt-8 flex flex-col gap-3 border-t border-white/10 pt-5 pb-24 text-[0.64rem] uppercase tracking-[0.14em] text-blue-200/55 sm:flex-row sm:items-center sm:justify-between">
        <p>
          © {year} {site.name}
        </p>
        <p>
          CNPJ {site.cnpj}
          {oab ? ` · OAB/BA ${oab}` : ''}
        </p>
        <a
          class="inline-flex items-center gap-2 transition hover:text-white"
          href="#topo"
          aria-label="Voltar ao topo da página"
        >
          Voltar ao topo
          <Icon name="lucide:arrow-up" size={13} />
        </a>
      </div>
    </div>
  </Container>
</footer>
