---
import { cn } from '@/shared/lib/cn';

type Variant = 'primary' | 'outline' | 'outline-light' | 'white' | 'whatsapp' | 'ghost';
type Size = 'sm' | 'md' | 'lg';

interface Props {
  href: string;
  variant?: Variant;
  size?: Size;
  class?: string;
  target?: string;
  rel?: string;
  ariaLabel?: string;
  dataWa?: boolean;
  dataWaLocation?: string;
}

const {
  href,
  variant = 'primary',
  size = 'md',
  class: className,
  target,
  rel,
  ariaLabel,
  dataWa = false,
  dataWaLocation,
} = Astro.props;

const variants: Record<Variant, string> = {
  primary: 'bg-brand text-white hover:bg-navy-800',
  outline: 'border border-border-interactive bg-transparent text-brand hover:bg-blue-50',
  'outline-light': 'border border-white/40 bg-transparent text-white hover:bg-white/10',
  white: 'bg-paper text-ink hover:bg-blue-50',
  whatsapp: 'bg-navy-900 text-white hover:bg-ink',
  ghost: 'bg-transparent text-brand hover:bg-blue-50',
};

const sizes: Record<Size, string> = {
  sm: 'min-h-10 px-4 text-[0.82rem]',
  md: 'min-h-12 px-5 text-sm',
  lg: 'min-h-13 px-6 text-[0.95rem]',
};

const classes = cn(
  'inline-flex items-center justify-center gap-2.5 rounded-[2px] font-bold leading-none tracking-[0.01em] transition duration-200',
  variants[variant],
  sizes[size],
  className,
);

const isExternal = href.startsWith('http');
const resolvedTarget = target ?? (isExternal ? '_blank' : undefined);
const resolvedRel = rel ?? (resolvedTarget === '_blank' ? 'noopener noreferrer' : undefined);
---

<a
  href={href}
  class={classes}
  target={resolvedTarget}
  rel={resolvedRel}
  aria-label={ariaLabel}
  data-wa={dataWa ? '' : undefined}
  data-wa-location={dataWaLocation}
>
  <slot />
</a>
