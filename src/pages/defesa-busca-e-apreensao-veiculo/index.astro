---
import LandingLayout from '@/layouts/LandingLayout.astro';
import Hero from '@/features/busca-apreensao/ui/Hero.astro';
import TrustBar from '@/features/busca-apreensao/ui/TrustBar.astro';
import Empathy from '@/features/busca-apreensao/ui/Empathy.astro';
import Bio from '@/features/busca-apreensao/ui/Bio.astro';
import Education from '@/features/busca-apreensao/ui/Education.astro';
import Services from '@/features/busca-apreensao/ui/Services.astro';
import Checklist from '@/features/busca-apreensao/ui/Checklist.astro';
import Process from '@/features/busca-apreensao/ui/Process.astro';
import Differentials from '@/features/busca-apreensao/ui/Differentials.astro';
import Faq from '@/features/busca-apreensao/ui/Faq.astro';
import Location from '@/features/busca-apreensao/ui/Location.astro';
import ContactFormSection from '@/features/contact-form/ui/ContactFormSection.astro';
import { contactSection, faq, landingSeo } from '@/features/busca-apreensao/content';
import { createMetadata } from '@/shared/seo/metadata';
import {
  breadcrumbSchema,
  faqSchema,
  legalServiceSchema,
  lawyerSchema,
  webPageSchema,
  websiteSchema,
} from '@/shared/seo/json-ld';

const metadata = createMetadata({
  title: landingSeo.title,
  description: landingSeo.description,
  path: landingSeo.path,
});

const jsonLd = [
  legalServiceSchema(),
  lawyerSchema(),
  websiteSchema(),
  webPageSchema({
    canonical: metadata.canonical,
    title: metadata.title,
    description: metadata.description,
  }),
  breadcrumbSchema(landingSeo.breadcrumb),
  faqSchema(faq),
];
---

<LandingLayout metadata={metadata} jsonLd={jsonLd}>
  <Hero />
  <TrustBar />
  <Empathy />
  <Bio />
  <Education />
  <Services />
  <Checklist />
  <Process />
  <Differentials />
  <Faq />
  <Location />
  <ContactFormSection {...contactSection} />
</LandingLayout>
