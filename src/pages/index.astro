---
import BaseLayout from '@/layouts/BaseLayout.astro';
import HomeHero from '@/features/home/ui/HomeHero.astro';
import TrustBar from '@/shared/ui/TrustBar.astro';
import HomeAreas from '@/features/home/ui/HomeAreas.astro';
import HomeInstagram from '@/features/instagram/ui/HomeInstagram.astro';
import ReviewsSection from '@/features/reviews/ui/ReviewsSection.astro';
import HomeLocation from '@/features/home/ui/HomeLocation.astro';
import ContactFormSection from '@/features/contact-form/ui/ContactFormSection.astro';
import { homeContact, homeReviews, homeSeo } from '@/features/home/content';
import { createMetadata } from '@/shared/seo/metadata';
import {
  legalServiceSchema,
  lawyerSchema,
  webPageSchema,
  websiteSchema,
} from '@/shared/seo/json-ld';

const metadata = createMetadata({
  title: homeSeo.title,
  description: homeSeo.description,
  path: homeSeo.path,
});

const jsonLd = [
  legalServiceSchema(),
  lawyerSchema(),
  websiteSchema(),
  webPageSchema({
    canonical: metadata.canonical,
    title: metadata.title,
    description: metadata.description,
  }),
];
---

<BaseLayout metadata={metadata} jsonLd={jsonLd}>
  <HomeHero />
  <TrustBar tone="dark" />
  <HomeAreas />
  <ReviewsSection {...homeReviews} />
  <HomeInstagram />
  <HomeLocation />
  <ContactFormSection {...homeContact} />
</BaseLayout>
