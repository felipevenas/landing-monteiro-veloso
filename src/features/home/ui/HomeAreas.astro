---
import Container from '@/shared/ui/Container.astro';
import Icon from '@/shared/ui/Icon.astro';
import Section from '@/shared/ui/Section.astro';
import SectionHeading from '@/shared/ui/SectionHeading.astro';
import { homeAreas } from '../content';
---

<Section id="areas" background="white" labelledby="areas-title">
  <Container>
    <div class="grid gap-10 lg:grid-cols-[0.74fr_1.26fr] lg:gap-16">
      <div class="lg:sticky lg:top-28 lg:self-start">
        <SectionHeading
          id="areas-title"
          eyebrow={homeAreas.eyebrow}

          title={homeAreas.title}
          description={homeAreas.description}
        />
        <p class="mt-7 border-l-2 border-brand pl-4 text-sm leading-relaxed text-text-2">
          Não sabe em qual caso você se encaixa? Comece pela conversa. A gente identifica o problema
          junto com você.
        </p>
      </div>

      <div class="border-t border-border">
        {homeAreas.items.map((item, index) => (
          <article class="grid grid-cols-[2.4rem_1fr] gap-4 border-b border-border py-6 first:pt-6 sm:grid-cols-[3.2rem_1fr] sm:gap-6 sm:py-7">
            <div class="flex flex-col items-start gap-3">
              <span
                class="font-display text-2xl leading-none text-blue-200 sm:text-3xl"
                aria-hidden="true"
              >
                {String(index + 1).padStart(2, '0')}
              </span>
              <Icon name={item.icon} size={18} class="text-brand" />
            </div>
            <div>
              <h3 class="font-display text-[1.55rem] leading-tight text-ink sm:text-[1.75rem]">
                {item.title}
              </h3>
              <p class="mt-2.5 max-w-xl text-sm leading-relaxed text-text-2 sm:text-[0.95rem]">
                {item.text}
              </p>
              <a
                href={item.href}
                aria-label={`${item.cta}: ${item.title}`}
                class="mt-4 inline-flex min-h-11 items-center gap-1.5 text-sm font-bold text-brand underline decoration-blue-200 underline-offset-4 transition hover:text-navy-800"
              >
                {item.cta}
                <Icon name="lucide:arrow-right" size={15} />
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </Container>
</Section>
