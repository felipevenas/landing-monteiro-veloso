---
import Container from '@/shared/ui/Container.astro';
import Icon from '@/shared/ui/Icon.astro';
import { homeTrust } from '../content';
---

<div class="border-b border-border bg-paper-alt">
  <Container class="grid grid-cols-2 gap-x-4 gap-y-4 py-5 sm:py-6 lg:grid-cols-4">
    {homeTrust.map((item) => (
      <div class="flex items-center gap-2.5 border-l border-border pl-3">
        <Icon name={item.icon} size={15} class="shrink-0 text-brand" />
        <span class="text-xs font-semibold leading-tight text-text-2 sm:text-[0.82rem]">
          {item.label}
        </span>
      </div>
    ))}
  </Container>
</div>
