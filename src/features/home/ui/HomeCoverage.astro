---
import Button from '@/shared/ui/Button.astro';
import Container from '@/shared/ui/Container.astro';
import Icon from '@/shared/ui/Icon.astro';
import Section from '@/shared/ui/Section.astro';
import SectionHeading from '@/shared/ui/SectionHeading.astro';
import BrazilMap from '@/shared/ui/BrazilMap.astro';
import { site } from '@/shared/config/site';
import { homeCoverage } from '../content';
---

<Section id="atendimento" background="white" labelledby="coverage-title">
  <Container>
    <div class="grid gap-10 lg:grid-cols-[1.05fr_0.95fr] lg:items-center lg:gap-16">
      <div>
        <SectionHeading
          id="coverage-title"
          eyebrow={homeCoverage.eyebrow}
          title={homeCoverage.title}
          description={homeCoverage.description}
        />

        <ul class="mt-7 grid gap-3 sm:grid-cols-2">
          {homeCoverage.points.map((point) => (
            <li class="flex items-start gap-2.5 border-t border-border pt-3 text-sm leading-snug text-text-2">
              <Icon name="lucide:check" size={15} class="mt-0.5 shrink-0 text-brand" />
              {point}
            </li>
          ))}
        </ul>

        <div class="mt-8">
          <Button
            href={site.phone.whatsapp}
            variant="primary"
            size="md"
            dataWa
            dataWaLocation="final"
          >
            <Icon name="lucide:message-circle" size={18} />
            {homeCoverage.cta}
          </Button>
        </div>
      </div>

      <figure class="mx-auto w-full max-w-[26rem] lg:mx-0">
        <div class="bg-paper px-2 py-4 sm:px-6 sm:py-8">
          <BrazilMap />
        </div>
        <figcaption class="mt-4 flex flex-wrap gap-x-6 gap-y-2">
          <span class="flex items-center gap-2 text-xs font-semibold text-text-2">
            <span class="size-3 shrink-0 rounded-[1px] bg-brand" aria-hidden="true"></span>
            {homeCoverage.legendOffice}
          </span>
          <span class="flex items-center gap-2 text-xs font-semibold text-text-2">
            <span
              class="size-3 shrink-0 rounded-[1px] bg-blue-200 ring-1 ring-blue-500"
              aria-hidden="true"
            ></span>
            {homeCoverage.legendOnline}
          </span>
        </figcaption>
      </figure>
    </div>
  </Container>
</Section>
