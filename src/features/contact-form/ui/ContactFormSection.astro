---
import Button from '@/shared/ui/Button.astro';
import Container from '@/shared/ui/Container.astro';
import Icon from '@/shared/ui/Icon.astro';
import Section from '@/shared/ui/Section.astro';
import { leadDeliveryMode, publicEnv } from '@/shared/config/env';
import { routes } from '@/shared/config/routes';
import { site } from '@/shared/config/site';
import ContactFormIsland from './ContactFormIsland';

interface Props {
  id?: string;
  source: string;
  eyebrow: string;
  title: string;
  description: string;
  benefits: string[];
  formTitle: string;
  formDescription: string;
  situationLabel: string;
  note?: string;
}

const {
  id = 'contato',
  source,
  eyebrow,
  title,
  description,
  benefits,
  formTitle,
  formDescription,
  situationLabel,
  note,
} = Astro.props;
---

<Section id={id} background="navy" labelledby={`${id}-title`}>
  <Container>
    <div class="grid items-start gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:gap-16">
      <div class="lg:sticky lg:top-28 lg:border-l lg:border-white/15 lg:pl-8">
        <p class="mb-4 flex items-center gap-3 text-sm font-medium text-sky-300">
          <span class="h-px w-8 bg-sky-300/70"></span>
          {eyebrow}
        </p>
        <h2 id={`${id}-title`} class="display-2 text-white">
          {title}
        </h2>
        <p class="mt-5 max-w-lg text-[1.02rem] leading-relaxed text-blue-200/85">{description}</p>

        <ul class="mt-8 space-y-4">
          {benefits.map((benefit) => (
            <li class="flex items-start gap-3 text-sm text-blue-200/90">
              <Icon name="lucide:check" size={15} class="mt-0.5 shrink-0 text-sky-300" />
              {benefit}
            </li>
          ))}
        </ul>

        {note && (
          <p class="mt-6 max-w-md border-t border-white/10 pt-5 text-xs leading-relaxed text-blue-200/65">
            {note}
          </p>
        )}

        <div class="mt-9 border-t border-white/10 pt-7">
          <p class="text-sm font-medium text-blue-200/80">Prefere conversar agora?</p>
          <Button
            href={site.phone.whatsapp}
            variant="outline-light"
            size="md"
            dataWa
            dataWaLocation="final"
            class="mt-3"
          >
            <Icon name="lucide:message-circle" size={18} />
            Falar pelo WhatsApp
          </Button>
        </div>
      </div>

      <div>
        <ContactFormIsland
          client:visible={{ rootMargin: '300px' }}
          whatsappUrl={site.phone.whatsapp}
          privacyUrl={routes.privacy}
          formEnabled={publicEnv.formEnabled}
          consentVersion={publicEnv.consentVersion}
          page={Astro.url.pathname}
          delivery={leadDeliveryMode}
          source={source}
          formTitle={formTitle}
          formDescription={formDescription}
          situationLabel={situationLabel}
        />
      </div>
    </div>
  </Container>
</Section>
