---
import { routes } from '@/shared/config/routes';
---

<div
  class="consent-banner fixed inset-x-3 bottom-3 z-[70] hidden rounded-[2px] border border-border bg-paper p-4 shadow-soft sm:inset-x-auto sm:right-5 sm:bottom-5 sm:max-w-[26rem] sm:p-5"
  data-consent-banner
  role="dialog"
  aria-live="polite"
  aria-labelledby="consent-title"
  aria-describedby="consent-description"
>
  <p class="text-xs font-medium text-blue-600">Privacidade</p>
  <h2 id="consent-title" class="mt-0.5 font-display text-xl text-ink">
    Cookies e análise
  </h2>
  <div id="consent-description" class="mt-1 text-xs leading-snug text-text-2">
    <p class="sm:hidden">Aceita a análise de uso com Google Analytics?</p>
    <p class="hidden sm:block">
      Usamos cookies necessários. Com sua autorização, também medimos o uso do site com o Google
      Analytics.
    </p>
  </div>
  <div class="mt-3 flex gap-2">
    <button
      type="button"
      class="inline-flex min-h-11 flex-1 items-center justify-center rounded-[2px] bg-brand px-4 text-xs font-bold text-white transition hover:bg-navy-800"
      data-consent-choice="granted"
    >
      Aceitar
    </button>
    <button
      type="button"
      class="inline-flex min-h-11 flex-1 items-center justify-center rounded-[2px] border border-border-interactive bg-paper px-4 text-xs font-bold text-brand transition hover:bg-blue-50"
      data-consent-choice="denied"
    >
      Recusar
    </button>
  </div>
  <a
    class="mt-1 block py-1 text-center text-xs font-semibold text-text-2 underline decoration-border underline-offset-4 hover:text-brand"
    href={routes.privacy}
  >
    Política de privacidade
  </a>
</div>

<style>
  :global(html[data-consent='undecided']) .consent-banner {
    display: block;
  }
</style>
