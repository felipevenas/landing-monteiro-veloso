---
import Container from '@/shared/ui/Container.astro';
import Icon from '@/shared/ui/Icon.astro';
import Section from '@/shared/ui/Section.astro';
import SectionHeading from '@/shared/ui/SectionHeading.astro';

interface InstagramFeed {
  eyebrow: string;
  title: string;
  description: string;
  profileUrl: string;
  profileLabel: string;
  posts: string[];
  consentNote: string;
  fallbackNote: string;
  trackLabel?: string;
}

interface Props {
  feed: InstagramFeed;
  id?: string;
}

const { feed, id = 'instagram' } = Astro.props;
const headingId = `${id}-title`;

function embedUrl(url: string): string {
  const parsed = new URL(url);
  if (!/(^|\.)instagram\.com$/i.test(parsed.hostname)) {
    throw new Error(`URL do Instagram inválida: ${url}`);
  }
  parsed.searchParams.set('utm_source', 'ig_embed');
  parsed.searchParams.set('utm_campaign', 'loading');
  return parsed.toString();
}
---

<Section id={id} background="navy" labelledby={headingId}>
  <Container>
    <div data-instagram-carousel>
      <div class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
        <SectionHeading
          id={headingId}
          eyebrow={feed.eyebrow}
          title={feed.title}
          description={feed.description}
          tone="dark"
        />

        <div class="flex flex-wrap items-center gap-2 self-start sm:self-auto">
          <a
            href={feed.profileUrl}
            class="inline-flex min-h-11 shrink-0 items-center gap-2 border border-white/35 px-4 text-sm font-bold text-white transition hover:bg-white/10"
            target="_blank"
            rel="noopener noreferrer"
          >
            <Icon name="lucide:instagram" size={17} />
            {feed.profileLabel}
            <span aria-hidden="true">↗</span>
          </a>
          <div class="flex gap-2">
            <button
              type="button"
              class="inline-flex size-11 items-center justify-center border border-white/35 text-white transition hover:bg-white/10 disabled:cursor-not-allowed disabled:opacity-35"
              aria-label="Post anterior"
              data-instagram-prev
            >
              <Icon name="lucide:arrow-left" size={18} />
            </button>
            <button
              type="button"
              class="inline-flex size-11 items-center justify-center border border-white/35 text-white transition hover:bg-white/10 disabled:cursor-not-allowed disabled:opacity-35"
              aria-label="Próximo post"
              data-instagram-next
            >
              <Icon name="lucide:arrow-right" size={18} />
            </button>
          </div>
        </div>
      </div>

      <div class="mt-10">
        <div
          class="flex snap-x snap-mandatory gap-5 overflow-x-auto pb-4 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
          data-instagram-track
          role="group"
          aria-roledescription="carrossel"
          aria-label={feed.trackLabel ?? 'Posts do Instagram'}
          tabindex="0"
        >
          {feed.posts.map((url, index) => (
            <div class="relative w-[min(21rem,max(302px,86vw))] shrink-0 snap-start overflow-hidden">
              <blockquote
                class="instagram-media !m-0 !min-w-0 !max-w-none border border-white/15 bg-white p-5"
                data-instgrm-permalink={embedUrl(url)}
                data-instgrm-version="14"
                data-instgrm-captioned
              >
                <a
                  href={url}
                  class="flex min-h-[26rem] flex-col items-center justify-center gap-3 text-center text-brand underline decoration-blue-200 underline-offset-4"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <Icon name="lucide:instagram" size={32} />
                  <span class="text-sm font-bold">Ver o post {index + 1} no Instagram</span>
                  <span class="text-xs font-medium text-text-2">{feed.fallbackNote}</span>
                </a>
              </blockquote>
            </div>
          ))}
        </div>

        <p class="mt-3 max-w-md text-xs leading-relaxed text-blue-200/70" data-instagram-note>
          {feed.consentNote}
        </p>
      </div>
    </div>
  </Container>
</Section>

<script>
  import '@/features/instagram/ui/instagram-carousel.client';
</script>

<style is:global>
  [data-instagram-track] iframe {
    max-width: 100%;
  }
</style>
