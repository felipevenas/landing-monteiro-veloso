---
import Container from '@/shared/ui/Container.astro';
import Icon from '@/shared/ui/Icon.astro';
import Section from '@/shared/ui/Section.astro';
import SectionHeading from '@/shared/ui/SectionHeading.astro';
import { empathy } from '../content';
---

<Section id="problema" background="white" labelledby="problema-title">
  <Container>
    <SectionHeading
      id="problema-title"
      eyebrow={empathy.eyebrow}
      title={empathy.title}
      highlight="não é o fim"
      description={empathy.description}
    />

    <div class="mt-10 grid gap-x-8 gap-y-10 md:grid-cols-3 lg:mt-12">
      {empathy.cards.map((card) => (
        <article class="border-t border-border pt-5">
          <span class="inline-flex size-9 items-center justify-center border border-blue-200 text-brand">
            <Icon name={card.icon} size={19} />
          </span>
          <h3 class="mt-5 font-display text-[1.35rem] leading-tight text-ink">{card.title}</h3>
          <p class="mt-3 text-sm leading-relaxed text-text-2">{card.text}</p>
        </article>
      ))}
    </div>

    <p class="mt-8 max-w-3xl text-xs leading-relaxed text-text-2">
      Conteúdo informativo. A situação de cada contrato e de cada processo precisa ser analisada
      individualmente.
    </p>
  </Container>
</Section>
