---
import Container from '@/shared/ui/Container.astro';
import Section from '@/shared/ui/Section.astro';
import SectionHeading from '@/shared/ui/SectionHeading.astro';
import { empathy } from '../content';
---

<Section id="problema" background="white" labelledby="problema-title">
  <Container>
    <SectionHeading
      id="problema-title"
      eyebrow={empathy.eyebrow}
      title={empathy.title}
      description={empathy.description}
    />

    <ol class="mt-9 grid gap-px overflow-hidden border border-border bg-border sm:grid-cols-3">
      {empathy.cards.map((card) => (
        <li class="bg-paper p-6">
          <span class="font-display text-sm leading-none text-blue-500" aria-hidden="true">
            {card.number}
          </span>
          <h3 class="mt-3 font-display text-[1.3rem] leading-tight text-ink">{card.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-text-2">{card.text}</p>
        </li>
      ))}
    </ol>

    <div class="mt-6 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
      <p class="max-w-2xl text-xs leading-relaxed text-text-2">{empathy.note}</p>
      <a
        href="#contato"
        class="inline-flex min-h-11 shrink-0 items-center gap-2 text-sm font-bold text-brand underline decoration-blue-200 underline-offset-4 transition hover:text-navy-800"
      >
        Quero que alguém confira o meu caso
      </a>
    </div>
  </Container>
</Section>
