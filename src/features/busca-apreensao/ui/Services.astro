---
import { Picture } from 'astro:assets';
import Container from '@/shared/ui/Container.astro';
import Section from '@/shared/ui/Section.astro';
import SectionHeading from '@/shared/ui/SectionHeading.astro';
import Icon from '@/shared/ui/Icon.astro';
import contractImage from '@/assets/images/img-contrato.jpg';
import { services } from '../content';
---

<Section id="servicos" background="paper" labelledby="servicos-title">
  <Container>
    <div class="grid gap-12 lg:grid-cols-[0.94fr_1.06fr] lg:items-start lg:gap-16">
      <figure class="lg:sticky lg:top-28">
        <div class="relative overflow-hidden border border-border bg-blue-50">
          <Picture
            src={contractImage}
            alt="Mãos apontando uma cláusula do contrato de financiamento de veículo, com calculadora, chaves e óculos sobre a mesa"
            formats={['avif', 'webp']}
            fallbackFormat="webp"
            widths={[640, 960, 1200]}
            sizes="(min-width: 1024px) 480px, 100vw"
            width={1408}
            height={768}
            loading="lazy"
            decoding="async"
            class="aspect-[4/3] h-full w-full object-cover"
          />
          <span class="absolute left-4 top-4 border border-white/30 bg-ink/85 px-3 py-1.5 text-[0.6rem] font-bold uppercase tracking-[0.18em] text-white backdrop-blur">
            Contrato de financiamento
          </span>
        </div>
        <figcaption class="border-x border-b border-border bg-paper px-4 py-3 text-xs leading-relaxed text-text-2">
          {services.photoCaption}
        </figcaption>
      </figure>

      <div>
        <SectionHeading
          id="servicos-title"
          eyebrow={services.eyebrow}

          title={services.title}
          description={services.description}
        />

        <ol class="mt-9">
          {services.items.map((service) => (
            <li class="border-t border-border py-6 first:border-t-0 first:pt-0">
              <div class="grid grid-cols-[2.4rem_1fr] gap-4 sm:grid-cols-[3rem_1fr] sm:gap-5">
                <span class="font-display text-2xl leading-none text-blue-500" aria-hidden="true">
                  {service.number}
                </span>
                <div>
                  <h3 class="font-display text-[1.45rem] leading-tight text-ink">
                    {service.title}
                  </h3>
                  <p class="mt-2 max-w-xl text-sm leading-relaxed text-text-2 sm:text-[0.95rem]">
                    {service.text}
                  </p>
                  <a
                    href={service.href}
                    class="mt-3 inline-flex min-h-11 items-center gap-1.5 text-sm font-bold text-brand underline decoration-blue-200 underline-offset-4 transition hover:text-navy-800"
                  >
                    {service.cta}
                    <Icon name="lucide:arrow-right" size={15} />
                  </a>
                </div>
              </div>
            </li>
          ))}
        </ol>

        <p class="mt-6 border-t border-border pt-4 text-xs leading-relaxed text-text-2">
          {services.note}
        </p>
      </div>
    </div>
  </Container>
</Section>
