---
import Container from '@/shared/ui/Container.astro';
import Icon from '@/shared/ui/Icon.astro';
import Section from '@/shared/ui/Section.astro';
import SectionHeading from '@/shared/ui/SectionHeading.astro';
import { services } from '../content';
---

<Section id="servicos" background="paper" labelledby="servicos-title">
  <Container>
    <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
      <SectionHeading
        id="servicos-title"
        eyebrow={services.eyebrow}
        title={services.title}
        highlight="seu caso"
        description={services.description}
      />
      <a
        href="#contato"
        class="inline-flex min-h-11 shrink-0 items-center text-sm font-bold text-brand underline decoration-blue-200 underline-offset-4 hover:text-navy-800"
      >
        Falar sobre a minha situação
      </a>
    </div>

    <div class="mt-10 grid gap-x-8 gap-y-10 lg:mt-12 lg:grid-cols-3">
      {services.items.map((service) => (
        <article class="flex flex-col border-t border-border pt-5">
          <span class="inline-flex size-9 items-center justify-center border border-blue-200 text-brand">
            <Icon name={service.icon} size={19} />
          </span>
          <h3 class="mt-5 font-display text-[1.45rem] leading-tight text-ink">{service.title}</h3>
          <p class="mt-3 flex-1 text-sm leading-relaxed text-text-2">{service.text}</p>
          <a
            href={service.href}
            class="mt-6 inline-flex min-h-11 items-center text-sm font-bold text-brand underline decoration-blue-200 underline-offset-4 hover:text-navy-800"
          >
            {service.cta}
          </a>
        </article>
      ))}
    </div>

    <p class="mt-7 max-w-3xl text-xs leading-relaxed text-text-2">{services.note}</p>
  </Container>
</Section>
