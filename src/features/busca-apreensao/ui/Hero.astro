---
import { Picture } from 'astro:assets';
import Button from '@/shared/ui/Button.astro';
import Container from '@/shared/ui/Container.astro';
import Icon from '@/shared/ui/Icon.astro';
import Eyebrow from '@/shared/ui/Eyebrow.astro';
import { publishable } from '@/shared/config/field';
import { site } from '@/shared/config/site';
import { escapeHtml } from '@/shared/lib/html';
import heroImage from '@/assets/images/img-carro.jpg';
import { hero } from '../content';

const oab = publishable(site.lawyer.oab);
const titleHtml = `${escapeHtml(hero.titleBefore)}<span class="text-sky-300">${escapeHtml(hero.titleHighlight)}</span>${escapeHtml(hero.titleAfter)}`;
---

<section class="relative overflow-hidden border-b border-white/10 bg-ink text-white">
  <div class="hero-grid pointer-events-none absolute inset-0" aria-hidden="true"></div>

  <div class="pointer-events-none absolute inset-y-0 right-0 hidden w-[46%] lg:block">
    <Picture
      src={heroImage}
      alt={hero.imageAlt}
      formats={['avif', 'webp']}
      fallbackFormat="webp"
      widths={[480, 640, 768]}
      sizes="46vw"
      width={768}
      height={1376}
      loading="eager"
      fetchpriority="high"
      decoding="async"
      class="h-full w-full object-cover object-[center_38%]"
    />
    <div class="scrim-left absolute inset-0"></div>
    <div class="absolute inset-x-0 bottom-0 h-40 bg-gradient-to-t from-ink to-transparent"></div>
  </div>

  <Container class="relative">
    <div class="max-w-[37rem] py-14 sm:py-16 lg:max-w-[52%] lg:py-24 lg:pr-8">
      <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
        <Eyebrow tone="dark">{hero.label}</Eyebrow>
        <span class="hidden text-[0.66rem] font-semibold uppercase tracking-[0.18em] text-blue-200/55 sm:inline">
          {hero.location}
        </span>
      </div>

      <h1 class="display-hero display-hero--compact mt-7 text-white" set:html={titleHtml} />

      <p class="mt-6 max-w-xl text-[1.05rem] leading-relaxed text-blue-200/90 sm:text-[1.12rem]">
        {hero.subtitle}
      </p>

      <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-center lg:flex-col lg:items-stretch xl:flex-row xl:items-center">
        <Button href={site.phone.whatsapp} variant="white" size="lg" dataWa dataWaLocation="hero">
          <Icon name="lucide:message-circle" size={19} />
          {hero.primaryCta}
        </Button>
        <Button href="#prazo" variant="outline-light" size="lg">
          {hero.secondaryCta}
        </Button>
      </div>

      <p class="mt-9 flex flex-wrap items-center gap-x-4 gap-y-2 border-t border-white/15 pt-4 text-[0.66rem] font-bold uppercase tracking-[0.16em] text-blue-200/60">
        <span>{hero.location}</span>
        <span class="h-3 w-px bg-white/20" aria-hidden="true"></span>
        <span>
          {hero.imageRole}
          {oab ? ` · OAB/BA ${oab}` : ''}
        </span>
      </p>
    </div>
  </Container>

  <div class="relative lg:hidden">
    <Picture
      src={heroImage}
      alt={hero.imageAlt}
      formats={['avif', 'webp']}
      fallbackFormat="webp"
      widths={[420, 640, 768]}
      sizes="100vw"
      width={768}
      height={1376}
      loading="eager"
      fetchpriority="high"
      decoding="async"
      class="h-[300px] w-full object-cover object-[center_42%] sm:h-[380px]"
    />
    <div class="scrim-bottom absolute inset-0"></div>
    <p class="absolute inset-x-5 bottom-4 flex items-center gap-2 text-[0.65rem] font-bold uppercase tracking-[0.18em] text-sky-300">
      <span class="size-1.5 rounded-full bg-sky-300" aria-hidden="true"></span>
      {hero.imageNote}
    </p>
  </div>

  <div class="absolute bottom-6 right-6 hidden w-[19rem] border border-white/20 bg-ink/85 p-4 backdrop-blur lg:block">
    <p class="font-display text-lg leading-tight text-white">{hero.imageCaption}</p>
    <p class="mt-0.5 text-[0.68rem] font-semibold uppercase tracking-[0.14em] text-sky-300">
      {hero.imageRole}
      {oab ? ` · OAB/BA ${oab}` : ''}
    </p>
    <p class="mt-3 flex items-center gap-2 border-t border-white/10 pt-2 text-[0.6rem] font-bold uppercase tracking-[0.16em] text-blue-200/60">
      <span class="size-1.5 rounded-full bg-sky-300" aria-hidden="true"></span>
      {hero.imageNote}
    </p>
  </div>
</section>
