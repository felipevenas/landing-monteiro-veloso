---
import { Picture } from 'astro:assets';
import Container from '@/shared/ui/Container.astro';
import Button from '@/shared/ui/Button.astro';
import Icon from '@/shared/ui/Icon.astro';
import { publishable } from '@/shared/config/field';
import { site } from '@/shared/config/site';
import { escapeHtml } from '@/shared/lib/html';
import heroImage from '@/assets/images/roberta-hero.jpg';
import { hero } from '../content';

const oab = publishable(site.lawyer.oab);
const titleHtml = escapeHtml(`${hero.titleBefore}${hero.titleHighlight}${hero.titleAfter}`);
---

<section class="relative overflow-hidden border-b border-white/10 bg-ink text-white">
  <div class="hero-grid pointer-events-none absolute inset-0" aria-hidden="true"></div>

  <Container class="hero-shell relative grid gap-12 lg:grid-cols-[1.04fr_0.96fr] lg:items-center lg:gap-16">
    <div class="max-w-2xl lg:border-l lg:border-white/15 lg:pl-8">
      <p class="flex items-center gap-3 text-sm font-medium text-sky-300">
        <span class="h-px w-8 bg-sky-300/70"></span>
        {hero.eyebrow}
      </p>

      <h1 class="display-hero display-hero--compact mt-6 text-white" set:html={titleHtml} />

      <p class="mt-6 max-w-xl text-[1.05rem] leading-relaxed text-blue-200/90 sm:text-[1.12rem]">
        {hero.subtitle}
      </p>

      <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-center">
        <Button href={site.phone.whatsapp} variant="white" size="lg" dataWa dataWaLocation="hero">
          <Icon name="lucide:message-circle" size={19} />
          {hero.primaryCta}
        </Button>
        <Button href="#problema" variant="outline-light" size="lg">
          {hero.secondaryCta}
        </Button>
      </div>

      <ul class="hero-trust mt-8 flex-wrap gap-x-5 gap-y-2 text-xs font-semibold text-blue-200/70">
        {hero.trust.map((item) => (
          <li class="flex items-center gap-1.5">
            <Icon name="lucide:check" size={13} class="text-sky-300" />
            {item}
          </li>
        ))}
      </ul>
    </div>

    <figure class="hero-media mx-auto w-full lg:mx-0 lg:ml-auto">
      <div class="relative aspect-[4/5] overflow-hidden border border-white/20 bg-navy-900">
        <Picture
          src={heroImage}
          alt={hero.imageAlt}
          formats={['avif', 'webp']}
          fallbackFormat="webp"
          widths={[480, 720, 960]}
          sizes="(min-width: 1024px) 440px, 92vw"
          width={960}
          height={1440}
          loading="eager"
          fetchpriority="high"
          decoding="async"
          class="h-full w-full object-cover object-[center_28%]"
        />
      </div>
      <figcaption class="flex items-end justify-between gap-4 border-x border-b border-white/20 bg-navy-900/50 px-4 py-3">
        <div>
          <p class="font-display text-lg text-white">{hero.imageCaption}</p>
          <p class="mt-0.5 text-[0.7rem] font-semibold text-sky-300">
            {hero.imageRole}
            {oab ? ` / OAB/BA ${oab}` : ''}
          </p>
        </div>
        <p class="text-right text-[0.65rem] font-semibold leading-tight text-blue-200/70">
          Salvador
          <br />
          Bahia
        </p>
      </figcaption>
    </figure>
  </Container>
</section>
