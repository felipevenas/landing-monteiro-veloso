---
import { Picture } from 'astro:assets';
import Container from '@/shared/ui/Container.astro';
import Icon from '@/shared/ui/Icon.astro';
import Section from '@/shared/ui/Section.astro';
import SectionHeading from '@/shared/ui/SectionHeading.astro';
import { publishable } from '@/shared/config/field';
import { site } from '@/shared/config/site';
import bioImage from '@/assets/images/roberta-hero.jpg';
import { bio } from '../content';

const oab = publishable(site.lawyer.oab);
---

<Section background="white" labelledby="sobre-title">
  <Container>
    <div class="grid gap-10 lg:grid-cols-[1.05fr_0.95fr] lg:items-center lg:gap-16">
      <div class="order-2 lg:order-1">
        <SectionHeading id="sobre-title" eyebrow={bio.eyebrow} title={bio.title} />

        <div class="mt-6 space-y-4 text-[1.01rem] leading-relaxed text-text-2">
          {bio.paragraphs.map((paragraph) => (
            <p>{paragraph}</p>
          ))}
        </div>

        <dl class="mt-7 grid grid-cols-2 gap-x-6 gap-y-5 border-t border-border pt-5">
          <div>
            <dt class="text-[0.62rem] font-bold uppercase tracking-[0.18em] text-blue-600">OAB</dt>
            <dd class="mt-1 text-sm font-semibold text-ink">
              {oab ? `OAB/BA ${oab}` : site.lawyer.role}
            </dd>
          </div>
          <div>
            <dt class="text-[0.62rem] font-bold uppercase tracking-[0.18em] text-blue-600">
              Atuação
            </dt>
            <dd class="mt-1 text-sm font-semibold text-ink">Direito Bancário</dd>
          </div>
        </dl>

        <a
          href={site.social.instagramLawyer}
          class="mt-6 inline-flex min-h-11 items-center gap-2 text-xs font-bold text-brand underline decoration-blue-200 underline-offset-4 transition hover:text-navy-800"
          target="_blank"
          rel="noopener noreferrer"
        >
          <Icon name="lucide:instagram" size={15} />
          Ver o dia a dia no Instagram
        </a>
      </div>

      <figure class="relative order-1 mx-auto w-full max-w-[24rem] lg:order-2 lg:mx-0">
        <div class="relative aspect-[2/3] overflow-hidden border border-border bg-navy-900">
          <Picture
            src={bioImage}
            alt={bio.imageAlt}
            formats={['avif', 'webp']}
            fallbackFormat="webp"
            widths={[420, 768, 1200]}
            sizes="(min-width: 768px) 384px, calc(100vw - 2.5rem)"
            width={1200}
            height={1800}
            loading="lazy"
            decoding="async"
            class="h-full w-full object-cover object-[center_15%]"
          />
        </div>
        <figcaption class="mt-3 flex items-center justify-between gap-4 border-t border-border pt-3 text-[0.7rem] font-semibold uppercase tracking-[0.14em] text-text-2">
          <span class="text-ink">{site.lawyer.displayName}</span>
          <span>Comércio · Salvador</span>
        </figcaption>
      </figure>
    </div>
  </Container>
</Section>
