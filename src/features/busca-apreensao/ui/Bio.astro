---
import { Picture } from 'astro:assets';
import Container from '@/shared/ui/Container.astro';
import Icon from '@/shared/ui/Icon.astro';
import Section from '@/shared/ui/Section.astro';
import { publishable } from '@/shared/config/field';
import { site } from '@/shared/config/site';
import bioImage from '@/assets/images/roberta-bio.jpg';
import { bio } from '../content';

const oab = publishable(site.lawyer.oab);
---

<Section background="paper" labelledby="sobre-title">
  <Container>
    <div class="grid items-start gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:gap-16">
      <figure class="mx-auto w-full max-w-[26rem] lg:mx-0">
        <div class="relative aspect-[4/5] overflow-hidden border border-border bg-blue-50">
          <Picture
            src={bioImage}
            alt={bio.imageAlt}
            formats={['avif', 'webp']}
            fallbackFormat="webp"
            widths={[420, 640, 840]}
            sizes="(min-width: 1024px) 420px, 90vw"
            width={840}
            height={1260}
            loading="lazy"
            decoding="async"
            class="h-full w-full object-cover object-[center_24%]"
          />
        </div>
        <figcaption class="border-x border-b border-border bg-paper-alt px-4 py-3">
          <p class="font-display text-lg text-ink">{site.lawyer.displayName}</p>
          <p class="mt-0.5 text-[0.7rem] font-semibold text-blue-600">
            {site.lawyer.role}
            {oab ? ` / OAB/BA ${oab}` : ''}
          </p>
          <p class="mt-2 border-t border-border pt-2 text-xs text-text-2">
            Comércio, Salvador, Bahia
          </p>
        </figcaption>
      </figure>

      <div>
        <span class="mb-5 block h-px w-12 bg-blue-500/70" aria-hidden="true"></span>
        <h2 id="sobre-title" class="display-2 text-ink">
          Escuta antes de qualquer resposta.
        </h2>
        <div class="mt-6 space-y-4 text-[1.01rem] leading-relaxed text-text-2">
          {bio.paragraphs.map((paragraph) => (
            <p>{paragraph}</p>
          ))}
        </div>

        <blockquote class="mt-7 border-l-2 border-blue-500 pl-5">
          <p class="font-display text-[1.3rem] leading-snug text-ink">“{bio.quote}”</p>
        </blockquote>

        <div class="mt-7 flex flex-wrap items-center gap-x-4 gap-y-2 border-t border-border pt-5">
          <p class="text-sm font-bold text-ink">{site.lawyer.name}</p>
          <span class="text-sm text-text-2">
            {site.lawyer.role}
            {oab ? ` / OAB/BA ${oab}` : ''}
          </span>
          <a
            href={site.social.instagramLawyer}
            class="ml-auto inline-flex min-h-11 items-center gap-1.5 text-xs font-bold text-brand underline decoration-blue-200 underline-offset-4 hover:text-navy-800"
            target="_blank"
            rel="noopener noreferrer"
          >
            <Icon name="lucide:instagram" size={14} />
            Instagram
          </a>
        </div>
      </div>
    </div>
  </Container>
</Section>
