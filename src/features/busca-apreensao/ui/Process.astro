---
import Container from '@/shared/ui/Container.astro';
import Icon from '@/shared/ui/Icon.astro';
import Section from '@/shared/ui/Section.astro';
import SectionHeading from '@/shared/ui/SectionHeading.astro';
import { process } from '../content';
---

<Section id="como-funciona" background="navy" labelledby="processo-title">
  <Container>
    <SectionHeading
      id="processo-title"
      eyebrow={process.eyebrow}
      title={process.title}
      highlight="caminho claro"
      description={process.description}
      tone="dark"
    />

    <ol class="mt-10 grid gap-px border border-white/15 bg-white/15 md:grid-cols-2 lg:mt-12 lg:grid-cols-4">
      {process.steps.map((step) => (
        <li class="bg-navy-900 p-6 sm:p-7">
          <div class="flex items-center justify-between">
            <span class="font-display text-3xl text-sky-300" aria-hidden="true">
              {step.number}
            </span>
            <span class="h-px w-10 bg-sky-300/30" aria-hidden="true"></span>
          </div>
          <h3 class="mt-6 font-display text-[1.35rem] text-white">{step.title}</h3>
          <p class="mt-3 text-sm leading-relaxed text-blue-200/80">{step.text}</p>
        </li>
      ))}
    </ol>

    <div class="mt-8 flex flex-col gap-4 border-l-2 border-sky-300/70 bg-white/[0.03] p-5 sm:flex-row sm:items-center sm:justify-between sm:p-6">
      <p class="flex items-start gap-2.5 text-sm leading-relaxed text-blue-200/80">
        <Icon name="lucide:info" size={17} class="mt-0.5 shrink-0 text-sky-300" />A contratação só
        acontece depois da análise e da apresentação das condições. Nenhum resultado é garantido.
      </p>
      <a
        href="#contato"
        class="inline-flex min-h-11 shrink-0 items-center justify-center rounded-[2px] border border-white/25 px-5 text-sm font-bold text-white transition hover:bg-white/10"
      >
        Começar pelo contato
      </a>
    </div>
  </Container>
</Section>
