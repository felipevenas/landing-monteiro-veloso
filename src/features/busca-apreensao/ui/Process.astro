---
import Container from '@/shared/ui/Container.astro';
import Icon from '@/shared/ui/Icon.astro';
import Section from '@/shared/ui/Section.astro';
import SectionHeading from '@/shared/ui/SectionHeading.astro';
import { process } from '../content';
---

<Section id="como-funciona" background="ink" labelledby="processo-title">
  <Container>
    <SectionHeading
      id="processo-title"
      eyebrow={process.eyebrow}

      title={process.title}
      description={process.description}
      tone="dark"
    />

    <ol class="relative mt-12 grid gap-9 sm:grid-cols-2 lg:grid-cols-4 lg:gap-6">
      <span
        class="absolute left-6 right-6 top-6 hidden h-px bg-white/15 lg:block"
        aria-hidden="true"
      ></span>
      {process.steps.map((step) => (
        <li class="relative">
          <span class="relative z-10 flex size-12 items-center justify-center rounded-full border border-sky-300/40 bg-ink font-display text-lg text-sky-300">
            {step.number}
          </span>
          <h3 class="mt-5 font-display text-[1.35rem] leading-tight text-white">{step.title}</h3>
          <p class="mt-2.5 text-sm leading-relaxed text-blue-200/75">{step.text}</p>
        </li>
      ))}
    </ol>

    <div class="mt-12 flex flex-col gap-4 border-l-2 border-sky-300/70 bg-white/[0.03] p-5 sm:flex-row sm:items-center sm:justify-between sm:p-6">
      <p class="flex max-w-2xl items-start gap-2.5 text-sm leading-relaxed text-blue-200/80">
        <Icon name="lucide:info" size={17} class="mt-0.5 shrink-0 text-sky-300" />
        {process.note}
      </p>
      <a
        href="#contato"
        class="inline-flex min-h-11 shrink-0 items-center justify-center gap-2 rounded-[2px] border border-white/25 px-5 text-sm font-bold text-white transition hover:bg-white/10"
      >
        Começar pelo contato
        <Icon name="lucide:arrow-right" size={15} />
      </a>
    </div>
  </Container>
</Section>
