---
import Container from '@/shared/ui/Container.astro';
import Icon from '@/shared/ui/Icon.astro';
import { trustItems } from '../content';
---

<div class="border-b border-white/10 bg-navy-900">
  <Container class="grid grid-cols-2 gap-x-4 gap-y-4 py-5 sm:py-6 lg:grid-cols-4">
    {trustItems.map((item) => (
      <div class="flex items-center gap-2.5 border-l border-white/15 pl-3">
        <Icon name={item.icon} size={15} class="shrink-0 text-sky-300" />
        <span class="text-xs font-semibold leading-tight text-blue-200/85 sm:text-[0.82rem]">
          {item.label}
        </span>
      </div>
    ))}
  </Container>
</div>
